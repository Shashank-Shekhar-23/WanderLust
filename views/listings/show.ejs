<% layout("./layouts/basic.ejs") %>

    <body>
        <script>
            const mapToken = "<%= process.env.MAP_TOKEN %>";
            const listing = <% - JSON.stringify(listing) %>;
        </script>
        <div class="row">
            <div class="col-12 col-md-8 offset-md-2 show-card">
                <h3>
                    <%= listing.title %>
                </h3>
                <img src="<%= listing.image.url %>" alt="listing_img" class="listing-img">
                <p>Owned by: <i>
                        <%= listing.owner.username %>
                    </i></p>
                <p class="show-des">
                    <%= listing.description %>
                </p>
                <p>Price: &#8377; <%= listing.price.toLocaleString("en-IN") %>
                        <p>
                        <p>location: <%= listing.location %>
                        </p>
                        <p>Country: <%= listing.country %>
                        </p>
                        <% if(listing.category) { %>
                            <p>Category: <span class="badge" style="background-color:#fe424d;">
                                    <%= listing.category %>
                                </span></p>
                            <% } %>
                                <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
                                    <div class="show-btns">
                                        <a href="/listings/<%= listing._id %>/edit"
                                            class="btn btn-bg-dark edit-btn">Edit</a>
                                        <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
                                            <button class="btn btn-bg-dark edit-btn">Delete</button>
                                        </form>
                                    </div>
                                    <% } %>
            </div>
        </div>

        <div class="col-12 col-md-8 offset-md-2 mb-3">
            <hr>
            <% if(currUser) { %>
                <h4>Leave a Review</h4>
                <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                    <div class="mb-3 mt-3">
                        <label for="rating" class="form-label">Rating</label>
                        <fieldset class="starability-grow">
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>
                    <div class="mb-3 mt-3">
                        <label for="comment" class="form-label">Comments</label>
                        <textarea name="review[comment]" id="comment" cols="20" rows="3" class="form-control"
                            required></textarea>
                        <div class="invalid-feedback">Please add some comments for review</div>
                    </div>

                    <button class="btn btn-outline-dark">Submit</button>
                </form>
                <% } %>

                    <div class="row mt-3">
                        <% if(listing.reviews.length> 0) { %>
                            <h4>All Reviews</h4>
                            <% } %>
                                <% for(review of listing.reviews) { %>
                                    <div class="card col-12 col-md-5 mb-3 ms-md-3">
                                        <div class="card-body">
                                            <h5 class="card-title">@<%= review.author.username %>
                                            </h5>
                                            <p class="card-text">
                                                <%= review.comment %>
                                            </p>
                                            <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>

                                            <% if(currUser && currUser._id.equals(review.author._id)) { %>
                                                <form class="mb-3" method="POST"
                                                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                    <button class="btn btn-dark btn-sm">Delete</button>
                                                </form>
                                                <% } %>
                                        </div>
                                    </div>
                                    <% } %>
                    </div>
        </div>
        <div class="col-12 col-md-8 offset-md-2 mb-3">
            <h3>Where you'll be</h3>
            <div id="map"></div>
        </div>

        <script src="/js/map.js"></script>

    </body>