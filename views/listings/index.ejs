<% layout("./layouts/basic.ejs") %>

    <body>
        <div id="filters">
            <% filters.forEach(filter=> { %>
                <a href="<%= filter.link %>" class="filter-link">
                    <div class="filter" style="opacity:<%= filter.isActive ? '1' : '0.7' %>;">
                        <i class="fa-solid <%= filter.icon %>"></i>
                        <p>
                            <%= filter.name %>
                        </p>
                    </div>
                </a>
                <% }) %>
                    <div class="tax-toggle">
                        <div class="form-check-reverse form-switch">
                            <input type="checkbox" class="form-check-input" role="switch" id="flexSwitchCheck">
                            <label for="flexSwitchCheck" class="form-check-label">Display Taxes</label>
                        </div>
                    </div>
        </div>
        <div class="row">
            <% for(let listing of allListings) { %>
                <div class="card listing-card" style="width: 18rem;">
                    <a href="/listings/<%= listing._id %>/" class="listing-link">
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_imgs"
                            style="height: 20rem;">
                        <div class="card-img-overlay"></div>
                        <div class="card-body">
                            <h5 class="card-title">
                                <b>
                                    <%= listing.title %>
                                </b>
                            </h5>
                            <p class="card-text">
                                &#8377;
                                <span class="base-price">
                                    <%= listing.price.toLocaleString("en-IN") %>
                                </span>
                                <span class="taxed-price" style="display: none;">
                                    <%= (listing.price * 1.18).toLocaleString("en-IN") %>
                                </span>
                                /night
                            </p>
                        </div>
                    </a>
                </div>
                <% } %>
        </div>
    </body>